<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- COMPLETE NAVBAR REPLACEMENT - Exact match from Odoo 17 -->
    <template id="pos_navbar_final" inherit_id="point_of_sale.POSNavbar" name="Echosphere Navbar Final" priority="9999">
        <!-- Replace the entire brand div -->
        <xpath expr="//div[contains(@class, 'brand')]" position="replace">
            <div class="brand d-flex align-items-center ps-3" role="button" tabindex="0">
                <span class="brand-text fs-4 fw-bold o_menu_brand" style="color: #714B67 !important;">Echosphere</span>
            </div>
        </xpath>
        
        <!-- Also remove any other Odoo text -->
        <xpath expr="//span[contains(text(), 'Odoo')]" position="replace">
            <span class="brand-text fs-4 fw-bold">Echosphere</span>
        </xpath>
    </template>
    
    <!-- Force hide any remaining Odoo text -->
    <template id="pos_hide_odoo" inherit_id="point_of_sale.POSInterface" priority="9999">
        <xpath expr="//head" position="inside">
            <style>
                /* Force hide Odoo and show Oakmont */
                .brand span:not(.brand-text):not(.oakmont-brand) {
                    display: none !important;
                }
                .brand .brand-text {
                    display: inline-block !important;
                    font-size: 1.25rem !important;
                    font-weight: bold !important;
                    color: #714B67 !important;
                }
                /* Hide any element containing Odoo text */
                span:contains('Odoo'),
                div:contains('Odoo') {
                    display: none !important;
                }
            </style>
        </xpath>
    </template>
</odoo>